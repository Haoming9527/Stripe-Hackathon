# Neon: direct URL for migrations, pooled URL for the application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"

NEXTAUTH_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
GOOGLE_ID=""
GOOGLE_SECRET=""
ADMIN_EMAILS="admin@example.com"

# Independent 32-byte base64 encryption key. Keep stable and back it up.
CREDITS_ENCRYPTION_KEY=""

# Optional test database: tests create and drop an isolated schema here.
TEST_DATABASE_URL=""
