generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_POOLED")
  directUrl = env("DATABASE_URL")
}

enum HackathonStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  HIDDEN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model User {
  id                String   @id @default(cuid())
  name              String?
  email             String?  @unique
  emailVerified     DateTime?
  image             String?
  accounts          Account[]
  sessions          Session[]
  participants      Participant[]
  ownedTeams        Team[]
  votes             Vote[]
  createdAt         DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Hackathon {
  id                   String @id @default(cuid())
  slug                 String @unique
  title                String
  tagline              String @default("")
  description          String @default("") @db.Text
  location             String @default("")
  timezone             String @default("Asia/Singapore")
  startsAt             DateTime
  endsAt               DateTime
  status               HackathonStatus @default(DRAFT)
  submissionOpensAt    DateTime
  submissionClosesAt   DateTime
  votingOpensAt        DateTime
  votingClosesAt       DateTime
  submissionsClosed   Boolean @default(false)
  votingClosed        Boolean @default(false)
  maxTeamSize         Int @default(4)
  minTeamSize         Int @default(1)
  teamSizeCeiling     Int @default(4)
  votesPerUser        Int @default(3)
  maxTrackSelections  Int @default(1)
  meetingUrl          String?
  attendeeInfo        String @default("") @db.Text
  schedule            Json @default("[]")
  resources           Json @default("[]")
  prizes              Json @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tracks              Track[]
  participants        Participant[]
  teams               Team[]
  projects            Project[]
  votes               Vote[]
  creditOffers        CreditOffer[]
}

model Track {
  id          String @id @default(cuid())
  hackathonId String
  name        String
  description String @default("")
  position    Int @default(0)
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  projects    ProjectTrack[]

  @@unique([hackathonId, name])
}

model Participant {
  id              String @id @default(cuid())
  hackathonId     String
  normalizedEmail String
  name            String?
  userId          String?
  teamId          String?
  revokedAt       DateTime?
  createdAt       DateTime @default(now())
  hackathon       Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  user            User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  team            Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  invitations     TeamInvitation[]
  vouchers        CreditVoucher[]

  @@unique([hackathonId, normalizedEmail])
  @@unique([hackathonId, userId])
  @@index([normalizedEmail, userId])
  @@index([teamId])
}

model Team {
  id             String @id @default(cuid())
  hackathonId    String
  name           String
  ownerId        String
  rosterLockedAt DateTime?
  createdAt      DateTime @default(now())
  hackathon      Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  owner          User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  members        Participant[]
  invitations    TeamInvitation[]
  project        Project?

  @@index([hackathonId])
}

model TeamInvitation {
  id            String @id @default(cuid())
  teamId        String
  participantId String
  status        InvitationStatus @default(PENDING)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  team          Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([teamId, participantId])
  @@index([participantId, status])
}

model Project {
  id            String @id @default(cuid())
  hackathonId   String
  teamId        String @unique
  name          String
  description   String @default("") @db.Text
  demoUrl       String?
  videoUrl      String @default("")
  githubUrl     String @default("")
  status        ProjectStatus @default(DRAFT)
  publishedAt   DateTime?
  consentAt     DateTime?
  consentUserId String?
  contributorIds String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  hackathon     Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  team          Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tracks        ProjectTrack[]
  votes         Vote[]

  @@index([hackathonId, status, publishedAt])
}

model ProjectTrack {
  projectId String
  trackId   String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  track     Track @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@id([projectId, trackId])
}

model Vote {
  id          String @id @default(cuid())
  hackathonId String
  userId      String
  projectId   String
  createdAt   DateTime @default(now())
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([hackathonId, userId])
  @@index([projectId])
}

model CreditOffer {
  id             String @id @default(cuid())
  hackathonId    String
  name           String
  sponsor        String @default("")
  description    String @default("") @db.Text
  valueLabel     String @default("")
  instructions   String @default("") @db.Text
  redemptionUrl  String?
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  hackathon      Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  vouchers       CreditVoucher[]

  @@index([hackathonId, createdAt])
}

model CreditVoucher {
  id              String @id @default(cuid())
  offerId         String
  encryptedValue  String @db.Text
  fingerprint     String
  participantId   String?
  assignedAt      DateTime?
  claimedAt       DateTime?
  createdAt       DateTime @default(now())
  offer           CreditOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  participant     Participant? @relation(fields: [participantId], references: [id], onDelete: Restrict)

  @@unique([offerId, fingerprint])
  @@unique([offerId, participantId])
  @@index([offerId, participantId])
  @@index([participantId])
}
